          "product_group": "M12"
        }
      ],
      "limit": 6
    },
    {
      "name": "failure_guard",
      "description": "Intentionally contains no true guard row. A lookup against guard=true fails when required data is invalid.",
      "source": "static",
      "columns": [
        {
          "name": "guard",
          "type": "boolean"
        },
        {
          "name": "failure_value",
          "type": "string"
        }
      ],
      "rows": [
        {
          "guard": false,
          "failure_value": ""
        }
      ],
      "limit": 1
    },
    {
      "name": "recipe_rules",
      "description": "Ordered recipe rules transcribed from the Recipe Selection worksheet. Rows are kept in ascending upper-bound order within each operation and product group.",
      "source": "static",
      "columns": [
